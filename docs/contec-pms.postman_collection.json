{
  "info": {
    "name": "Contec PMS",
    "description": "Construction project, task and approval management API. Run a Login request first; it stores the token. Project and task ids are stored as you create them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "taskVersion", "value": "0" },
    { "key": "engineerId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.accessToken);",
                  "pm.test('token issued', () => pm.expect(body.accessToken).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@contec.com\",\n  \"password\": \"Admin@123\"\n}" }
          }
        },
        {
          "name": "Login (project manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('token', pm.response.json().accessToken);"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alex.pm@contec.com\",\n  \"password\": \"Password@123\"\n}" }
          }
        },
        {
          "name": "Login (site engineer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('token', pm.response.json().accessToken);"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"sam.eng@contec.com\",\n  \"password\": \"Password@123\"\n}" }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create site engineer (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('engineerId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.engineer@contec.com\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"New Engineer\",\n  \"role\": \"SITE_ENGINEER\"\n}"
            }
          }
        },
        {
          "name": "List site engineers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users?role=SITE_ENGINEER&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "role", "value": "SITE_ENGINEER" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('projectId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harbour Bridge Retrofit\",\n  \"description\": \"Strengthening works on the south approach.\",\n  \"location\": \"South Harbour\",\n  \"startDate\": \"2026-10-01\",\n  \"expectedCompletionDate\": \"2027-04-30\",\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?page=0&size=20&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" },
                { "key": "status", "value": "ACTIVE", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}"] }
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Harbour Bridge Retrofit\",\n  \"description\": \"Scope extended to the north approach.\",\n  \"location\": \"South Harbour\",\n  \"startDate\": \"2026-10-01\",\n  \"expectedCompletionDate\": \"2027-06-30\",\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "Add member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/members", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "members"] },
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{engineerId}}\n}" }
          }
        },
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/members", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "members"] }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('taskId', body.id);",
                  "pm.collectionVariables.set('taskVersion', body.version);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "tasks"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Install bearing plates\",\n  \"description\": \"Span 3 to span 5.\",\n  \"priority\": \"HIGH\",\n  \"expectedCompletionDate\": \"2026-12-15\",\n  \"assigneeId\": {{engineerId}}\n}"
            }
          }
        },
        {
          "name": "List project tasks (filter + sort + page)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?page=0&size=20&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "tasks"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" },
                { "key": "status", "value": "IN_PROGRESS", "disabled": true },
                { "key": "priority", "value": "HIGH", "disabled": true },
                { "key": "assigneeId", "value": "{{engineerId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get task (refreshes taskVersion)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('taskVersion', pm.response.json().version);"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
          }
        },
        {
          "name": "Update task (needs version)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Install bearing plates (revised)\",\n  \"description\": \"Span 3 to span 6.\",\n  \"priority\": \"CRITICAL\",\n  \"expectedCompletionDate\": \"2026-12-20\",\n  \"version\": {{taskVersion}}\n}"
            }
          }
        },
        {
          "name": "Assign task (needs version)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "assign"] },
            "body": { "mode": "raw", "raw": "{\n  \"assigneeId\": {{engineerId}},\n  \"version\": {{taskVersion}}\n}" }
          }
        },
        {
          "name": "Start task (engineer)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/start", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "start"] }
          }
        },
        {
          "name": "Update progress (engineer, needs version)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/progress", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "progress"] },
            "body": { "mode": "raw", "raw": "{\n  \"progress\": 60,\n  \"note\": \"Plates 1-8 seated.\",\n  \"version\": {{taskVersion}}\n}" }
          }
        },
        {
          "name": "Complete task (engineer)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/complete", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "complete"] }
          }
        },
        {
          "name": "Approve task (project manager)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "approve"] }
          }
        },
        {
          "name": "Reject task (project manager)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/reject", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "reject"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Torque records missing for span 5.\"\n}" }
          }
        },
        {
          "name": "Task activity history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/activities?page=0&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "activities"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "50" }
              ]
            }
          }
        }
      ]
    }
  ]
}
